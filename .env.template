# ==========================================================
# Template environment variable untuk pgbouncer-image.
# Copy jadi .env lalu isi nilai sebenarnya:
#   cp .env.template .env
# .env TIDAK ikut di-commit (lihat .gitignore) karena berisi kredensial asli.
# ==========================================================

# --- WAJIB diisi (tidak punya default aman, lihat entrypoint.sh) ---
DB_HOST=
DB_PORT=5432
DB_NAME=
AUTH_USER=
# Format password mengikuti AUTH_TYPE di bawah:
# - md5   : "md5" + md5(password + username), contoh generate:
#           echo -n "<password><username>" | md5sum
# - plain : password apa adanya (tidak disarankan untuk production)
AUTH_PASSWORD=

# --- Opsional (default di-resolve oleh entrypoint.sh kalau kosong) ---
AUTH_TYPE=md5

# Admin & stats console PgBouncer (default: pgbouncer_admin / pgbouncer_stats)
ADMIN_USER=pgbouncer_admin
ADMIN_PASSWORD=
STATS_USER=pgbouncer_stats
STATS_PASSWORD=

# Pooling
POOL_MODE=transaction
MAX_CLIENT_CONN=500
DEFAULT_POOL_SIZE=25
MIN_POOL_SIZE=5
RESERVE_POOL_SIZE=5

# TLS client -> PgBouncer (default: disable)
# Kalau diisi selain "disable" (require/verify-ca/verify-full), CLIENT_TLS_CERT
# dan CLIENT_TLS_KEY WAJIB diisi juga.
#CLIENT_TLS_SSLMODE=disable
#CLIENT_TLS_CERT=
#CLIENT_TLS_KEY=

# TLS PgBouncer -> server Postgres (default: require)
#SERVER_TLS_SSLMODE=require
