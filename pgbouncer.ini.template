;; ==========================================================
;; PgBouncer config — Production template untuk platform PPOB
;; Placeholder ${...} diisi otomatis oleh entrypoint.sh saat container start
;; ==========================================================

[databases]
${DB_NAME} = host=${DB_HOST} port=${DB_PORT} dbname=${DB_NAME} pool_size=${DEFAULT_POOL_SIZE}

[pgbouncer]
;; --- Listener ---
listen_addr = 0.0.0.0
listen_port = 6432
unix_socket_dir = /var/run/pgbouncer

;; --- Autentikasi ---
auth_type = ${AUTH_TYPE}
auth_file = /etc/pgbouncer/userlist.txt

;; --- Admin & stats console (akses dibatasi via pg_hba-style admin_users) ---
admin_users = ${ADMIN_USER}
stats_users = ${STATS_USER}

;; --- Pooling mode ---
;; transaction: pool dilepas kembali setelah tiap transaksi selesai — paling cocok
;; untuk beban PPOB dengan banyak koneksi pendek (cek pulsa, bayar PLN, dll)
pool_mode = ${POOL_MODE}

;; --- Batas koneksi ---
;; max_client_conn: total koneksi dari aplikasi ke PgBouncer
;; default_pool_size: koneksi aktual dari PgBouncer ke PostgreSQL per database/user pair
;; Aturan umum: default_pool_size jauh lebih kecil dari max_client_conn,
;; karena tujuan pooling adalah membatasi koneksi riil ke Postgres.
max_client_conn = ${MAX_CLIENT_CONN}
default_pool_size = ${DEFAULT_POOL_SIZE}
min_pool_size = ${MIN_POOL_SIZE}
reserve_pool_size = ${RESERVE_POOL_SIZE}
reserve_pool_timeout = 3

;; --- Timeout (krusial untuk mencegah koneksi menggantung di jalur transaksi finansial) ---
server_idle_timeout = 600
server_lifetime = 3600
server_connect_timeout = 15
server_login_retry = 15
query_timeout = 30
query_wait_timeout = 30
client_idle_timeout = 0
client_login_timeout = 60
idle_transaction_timeout = 30

;; --- TLS ke client (aplikasi -> PgBouncer) ---
client_tls_sslmode = ${CLIENT_TLS_SSLMODE}
client_tls_cert_file = ${CLIENT_TLS_CERT}
client_tls_key_file = ${CLIENT_TLS_KEY}

;; --- TLS ke server (PgBouncer -> PostgreSQL) ---
server_tls_sslmode = ${SERVER_TLS_SSLMODE}

;; --- Logging ---
log_connections = 1
log_disconnections = 1
log_pooler_errors = 1
log_stats = 1
stats_period = 60
logfile = /var/log/pgbouncer/pgbouncer.log
pidfile = /var/run/pgbouncer/pgbouncer.pid

;; --- Keamanan tambahan ---
ignore_startup_parameters = extra_float_digits
disable_pqexec = 0
application_name_add_host = 1
